# Copy to .env and fill in. .env is gitignored — never commit real values.

# Whole AI Core service-key JSON on ONE line, UNQUOTED.
# From: BTP cockpit → AI Core instance → Service Keys → Create,
# or: cf service-key <instance> <key-name>
# Contains clientid, clientsecret, url, serviceurls.AI_API_URL.
#
# Two traps, both of which fail as an opaque 401 rather than a parse error:
#
#  1. Do NOT wrap the value in quotes. docker compose reads env_file values
#     literally, so the quotes become part of the JSON string.
#  2. Escape every literal '$' as '$$'. compose expands $VAR inside env_file
#     values, so an unescaped '$' in the client secret is silently deleted and
#     you get a truncated secret. Compose turns '$$' back into a single '$'.
#     Client secrets contain '$' often enough that this WILL bite you.
AICORE_SERVICE_KEY={"clientid":"...","clientsecret":"...","url":"https://<tenant>.authentication.<region>.hana.ondemand.com","serviceurls":{"AI_API_URL":"https://api.ai.prod.<region>.aws.ml.hana.ondemand.com"}}

# Resource group holding the orchestration deployment.
# There is deliberately no AICORE_ORCH_DEPLOYMENT_ID: the LiteLLM SAP provider
# discovers the deployment itself by listing /lm/deployments and matching
# scenarioId == "orchestration". See docs/decisions.md D8.
AICORE_RESOURCE_GROUP=default

# Master key for the proxy. Generate: openssl rand -hex 24  → prefix with sk-
LITELLM_MASTER_KEY=sk-changeme

# Used by scripts/smoke_test.py
LITELLM_BASE_URL=http://localhost:4000
SMOKE_MODEL=gpt-4o-governed
